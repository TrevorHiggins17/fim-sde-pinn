        t_span=(0.0, 200.0),
        y0=y0,
        method="LSODA",
        rtol=1e-8,
        atol=1e-10,
        dense_output=True,
        t_eval=np.linspace(0.0, 200.0, 5001),
    )
    sols[cname] = sol
    X, N, qN, A, S, L, xact, H = sol.y
    inv = X - (xact + S + L)
    print(f"{cname:8s}  status={sol.status}  nfev={sol.nfev}"
          f"  |inv|_max={np.max(np.abs(inv)):.2e}"
          f"  X_fin={X[-1]:.4f}  S_fin={S[-1]:.5f}  L_fin={L[-1]:.5f}")


